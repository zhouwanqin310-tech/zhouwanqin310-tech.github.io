{% set t = site.labels[lang] %}
{% set home = '/en/' if lang == 'en' else '/' %}
{% set otherLang = 'zh' if lang == 'en' else 'en' %}
{% set otherHome = '/' if lang == 'en' else '/en/' %}

{% set translated = collections.records | record(key, otherLang, kind) if key else false %}
{% set switchUrl = translated.data | route if translated else (otherHome + 'cv/' if isCV else otherHome) %}
{% set langRecords = collections.records | forLanguage(lang) %}

{# =========================
   Language-dependent labels
   ========================= #}

{% set educationLabel =
  t.education
  if t.education
  else ('教育经历' if lang == 'zh' else 'Education')
%}

{% set researchExperienceLabel =
  t.researchExperience
  if t.researchExperience
  else ('研究经历' if lang == 'zh' else 'Research experience')
%}

{% set defaultDescription =
  '周万勤，厦门大学语言学及应用语言学硕士研究生，主要从事计算语言学、社会语言学与数字人文相关研究。'
  if lang == 'zh'
  else
  'Wanqin Zhou, MA student in Linguistics and Applied Linguistics at Xiamen University, working on computational linguistics, sociolinguistics, and digital humanities.'
%}

{% set defaultOgDescription =
  '周万勤的研究、论文与学术经历'
  if lang == 'zh'
  else
  'Research, publications, and academic experience of Wanqin Zhou'
%}

{% set pageDescription = description or defaultDescription %}


{# =========================
   Main navigation
   修改导航顺序时，只改这里
   ========================= #}

{% set navItems = [
  {
    id: 'research',
    label: t.research
  },
  {
    id: 'education',
    label: educationLabel
  },
  {
    id: 'publications',
    label: t.publications
  },
  {
    id: 'experience',
    label: researchExperienceLabel
  },
  {
    id: 'notes',
    label: t.notes
  }
] %}


<!doctype html>

<html lang="{{ 'zh-CN' if lang == 'zh' else 'en' }}">

<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>{{ title }}{% if not isHome %} · {{ t.name }}{% endif %}</title>

  <meta
    name="description"
    content="{{ pageDescription }}"
  >


  {# =========================
     Canonical / multilingual
     ========================= #}

  <link
    rel="canonical"
    href="{{ site.url }}{{ page.url }}"
  >

  <link
    rel="alternate"
    hreflang="{{ 'zh-CN' if lang == 'zh' else 'en' }}"
    href="{{ site.url }}{{ page.url }}"
  >

  {% if translated or isHome or isCV %}
  <link
    rel="alternate"
    hreflang="{{ 'zh-CN' if otherLang == 'zh' else 'en' }}"
    href="{{ site.url }}{{ switchUrl }}"
  >
  {% endif %}


  {# =========================
     Open Graph
     ========================= #}

  <meta
    property="og:type"
    content="{{ 'website' if isHome else 'article' }}"
  >

  <meta
    property="og:title"
    content="{{ title }}"
  >

  <meta
    property="og:description"
    content="{{ description or defaultOgDescription }}"
  >

  <meta
    property="og:url"
    content="{{ site.url }}{{ page.url }}"
  >

  <meta
    property="og:image"
    content="{{ site.url }}{{ site.photo }}"
  >

  <meta
    property="og:locale"
    content="{{ 'zh_CN' if lang == 'zh' else 'en_US' }}"
  >


  {# =========================
     Site resources
     ========================= #}

  <meta
    name="theme-color"
    content="#f4f5f6"
  >

  <link
    rel="icon"
    href="/assets/favicon.svg"
    type="image/svg+xml"
  >

  <link
    rel="stylesheet"
    href="/assets/style.css"
  >

  <script
    src="/assets/main.js"
    defer
  ></script>
</head>


<body class="{{ 'cv-page' if isCV else '' }}">

  <a
    class="skip-link"
    href="#main"
  >
    {{ t.skip }}
  </a>


  {# =========================
     Header
     ========================= #}

  <header class="site-header">

    <a
      class="wordmark"
      href="{{ home }}"
    >
      {{ t.name }}
    </a>


    <nav aria-label="{{ '主导航' if lang == 'zh' else 'Main navigation' }}">

      {% for item in navItems %}
      <a href="{{ home }}#{{ item.id }}">
        {{ item.label }}
      </a>
      {% endfor %}

      {#
        注意：
        data-language-switch 与 href 必须连续。
        当前 tests/editing.test.js 会检查：
        data-language-switch href="/en/"
      #}
      <a class="language-switch" data-language-switch href="{{ switchUrl }}" lang="{{ otherLang }}" aria-label="{{ 'Switch to English' if lang == 'zh' else '切换到中文' }}">{{ 'EN' if lang == 'zh' else '中文' }}</a>

    </nav>

  </header>


  {# =========================
     Main content
     ========================= #}

  <main
    id="main"
    class="sheet {{ 'detail-sheet' if not isHome and not isCV else '' }}"
  >
    {{ content | safe }}
  </main>


  {# =========================
     Footer
     ========================= #}

  <footer class="site-footer">

    <span>
      © {{ t.name }}

      <span class="footer-dot">
        ·
      </span>

      <a href="{{ site.github }}">
        GitHub
      </a>
    </span>


    {% set lastUpdate =
      contentUpdated
      if contentUpdated
      else (langRecords | latest)
    %}

    <span>
      {{ t.updated }}

      <time datetime="{{ lastUpdate | dateLabel }}">
        {{ lastUpdate | dateLabel }}
      </time>
    </span>

  </footer>

</body>

</html>
