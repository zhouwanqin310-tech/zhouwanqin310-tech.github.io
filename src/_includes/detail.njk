---
layout: base.njk
---
{% from 'macros.njk' import resourceLinks %}
{% set t = site.labels[lang] %}
{% set home = '/en/' if lang == 'en' else '/' %}
<a class="back-link" href="{{ home }}#{{ kind }}">← {{ kind | kindLabel(lang) }}</a>
<article class="detail-article">
  <header class="article-header"><h1>{{ title }}</h1>
  {% if originalTitle %}<p class="original-title">{{ originalTitle }}</p>{% endif %}
  {% if authors %}<p class="authors">{{ authors | authorsHtml | safe }}</p>{% elif contribution %}<p class="authors">{{ contribution }}</p>{% endif %}
  {% if venue %}<p class="venue">{{ venue }}{% if year %} · {{ year }}{% endif %}{% if volume %}, {{ volume }}{% endif %}{% if pages %}, {{ pages }}{% endif %}</p>{% endif %}
  {% if status %}<p class="article-status">{{ status | statusLabel(lang) }}{% if reviewStatus %} · {{ reviewStatus }}{% endif %}</p>{% endif %}
  <p class="article-updated">{{ t.updated }} <time datetime="{{ contentUpdated | dateLabel }}">{{ contentUpdated | dateLabel }}</time></p>
  </header>
  {% if image %}<img class="article-image" src="{{ image }}" alt="{{ imageAlt or title }}">{% endif %}
  <div class="prose">{{ content | safe }}</div>
  {{ resourceLinks(links) }}
  {% if bibtex %}<details class="citation"><summary>BibTeX</summary><pre><code>{{ bibtex }}</code></pre></details>{% endif %}
</article>
